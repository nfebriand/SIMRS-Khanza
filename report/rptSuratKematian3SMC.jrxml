	<parameter name="zona" class="java.lang.String"/>
	<queryString>
		<![CDATA[select ifnull(pasien.nm_pasien,'') as nm_pasien,pasien.no_rkm_medis,ifnull(pasien.no_ktp,'') as no_ktp,if(pasien.jk='L','Laki-Laki','Perempuan') as jk,ifnull(pasien.tmp_lahir,'') as tmp_lahir,ifnull(date_format(pasien.tgl_lahir,'%d-%m-%Y'),'') as tgl_lahir,ifnull(pasien.agama,'') as agama,ifnull(pasien.alamat,'') as alamat,ifnull(kelurahan.nm_kel,'') as nm_kel,ifnull(kecamatan.nm_kec,'') as nm_kec,ifnull(kabupaten.nm_kab,'') as nm_kab,ifnull(propinsi.nm_prop,'') as nm_prop,ifnull(concat(day(pasien_mati.tanggal),' ',elt(month(pasien_mati.tanggal),'Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'),' ',year(pasien_mati.tanggal)),'') as tanggal,ifnull(time_format(pasien_mati.jam,'%H.%i'),'') as jam,ifnull(case when timestampdiff(YEAR,pasien.tgl_lahir,pasien_mati.tanggal)>=1 then concat(timestampdiff(YEAR,pasien.tgl_lahir,pasien_mati.tanggal),' Tahun') when timestampdiff(MONTH,pasien.tgl_lahir,pasien_mati.tanggal)>=1 then concat(timestampdiff(MONTH,pasien.tgl_lahir,pasien_mati.tanggal),' Bulan') else concat(timestampdiff(DAY,pasien.tgl_lahir,pasien_mati.tanggal),' Hari') end,pasien.umur) as umur_meninggal,ifnull(pasien_mati.temp_meninggal,'') as temp_meninggal,dokter.nm_dokter from pasien_mati inner join pasien on pasien_mati.no_rkm_medis=pasien.no_rkm_medis inner join dokter on pasien_mati.kd_dokter=dokter.kd_dokter left join kelurahan on pasien.kd_kel=kelurahan.kd_kel left join kecamatan on pasien.kd_kec=kecamatan.kd_kec left join kabupaten on pasien.kd_kab=kabupaten.kd_kab left join propinsi on pasien.kd_prop=propinsi.kd_prop where pasien_mati.no_rkm_medis=?]]>
	</queryString>
